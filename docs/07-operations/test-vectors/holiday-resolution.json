      "expected": { "working": false, "holiday": { "kind": "national", "name": "National day B" } }
    },
    {
      "name": "negating one kind leaves the other standing",
      "source": "holiday.md §9 — two kinds one date; negation is per kind",
      "input": {
        "scope": { "companyId": "c1", "branchId": "b1" },
        "date": "2026-12-25",
        "rows": [
          {
            "companyId": null,
