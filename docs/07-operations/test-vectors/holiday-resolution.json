            "date": "2026-05-01",
            "name": "National day A",
            "kind": "national",
            "observed": true
          },
          {
            "companyId": "c1",
            "branchId": null,
            "date": "2026-05-01",
            "name": "National day A",
            "kind": "national",
            "observed": false
          },
          {
            "companyId": "c1",
            "branchId": "b1",
            "date": "2026-05-01",
            "name": "National day A",
            "kind": "national",
            "observed": true
          }
        ]
      },
      "expected": { "working": false, "holiday": { "kind": "national", "name": "National day A" } }
    },
    {
      "name": "a sibling branch keeps its company's negation",
      "source": "holiday.md BR-HOL-002 — a branch row addresses one branch",
      "input": {
        "scope": { "companyId": "c1", "branchId": "b2" },
        "date": "2026-05-01",
        "rows": [
          {
            "companyId": null,
