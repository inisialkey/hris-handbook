            "companyId": "c1",
            "branchId": "b1",
            "date": "2026-05-01",
            "name": "National day A",
            "kind": "national",
            "observed": true
          }
        ]
      },
      "expected": { "working": true }
    },
    {
      "name": "two kinds on one date, both observed — national leads the display",
      "source": "holiday.md BR-HOL-002 — display priority national > cuti_bersama > custom",
      "input": {
        "scope": { "companyId": "c1", "branchId": "b1" },
        "date": "2026-12-25",
